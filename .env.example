# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=knowledgebase
DB_USER=postgres
DB_PASSWORD=postgres

# AI Provider Mode: 'local' (free, offline, 0 quota limits) or 'openai' (requires prepaid OpenAI credits)
AI_MODE=local

# OpenAI API Configuration (Required when AI_MODE=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# JWT Secret Key (Min 256 bits / 32+ characters for HMAC-SHA256)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# RAG & Chunking Configuration
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.60
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# Upload Configuration
MAX_FILE_SIZE_MB=10
